# Kopiera denna fil till .env och fyll i dina egna nycklar.
# Commita ALDRIG .env till GitHub.

# 1. Google Gemini API (för fristående Python-agenter via google-antigravity SDK)
# Hämta nyckel: https://aistudio.google.com/app/api-keys
GEMINI_API_KEY=

# 2. Alternativ: Vertex AI (om du vill köra via GCP-krediter istället för AI Studio)
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=global

# 3. YouTube Data API v3 (för sökning, statistik och hantering via Python)
# Skapas i Google Cloud Console -> APIs & Services -> Credentials
YOUTUBE_API_KEY=

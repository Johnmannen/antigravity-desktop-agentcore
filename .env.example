# Copy this file to .env and add your own API keys.
# NEVER commit .env to GitHub.

# --- Free-Tier Multi-Provider LLM Router Keys (tools/llm_router.py) ---
# Rank and stack as many free-tier providers as you like; the router falls back automatically on 429 rate limits.

# 1. Google AI Studio Free Tier (Gemini Flash, Flash Lite, Gemma)
# Get key: https://aistudio.google.com/app/api-keys
GEMINI_API_KEY=

# 2. Groq Free Tier (Fast OpenAI-compatible inference)
# Get key: https://console.groq.com/keys
GROQ_API_KEY=

# 3. OpenRouter Free Tier (:free models)
# Get key: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# 4. NVIDIA API Free Tier (Nemotron / NIM)
# Get key: https://build.nvidia.com/
NVIDIA_API_KEY=

# --- Optional Cloud & Media Integrations ---
# Vertex AI (if using GCP credits instead of AI Studio)
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=global

# YouTube Data API v3 (for channel metrics & search via Python)
YOUTUBE_API_KEY=

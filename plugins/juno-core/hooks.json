{
  "juno-post-edit-verify": {
    "PostToolUse": [
      {
        "matcher": "write_file|edit_file",
        "hooks": [
          {
            "type": "command",
            "command": "<PROJECT_ROOT>\\.venv\\Scripts\\python.exe <USER_HOME>\\.gemini\\config\\plugins\\juno-core\\scripts\\post_edit_verify.py",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "juno-agy-sync": {
    "SessionStart": [
      {
        "type": "command",
        "command": "<PROJECT_ROOT>\\.venv\\Scripts\\python.exe <PROJECT_ROOT>\\tools\\agy_sync.py --hook",
        "timeout": 10
      },
      {
        "type": "command",
        "command": "<PROJECT_ROOT>\\.venv\\Scripts\\python.exe <PROJECT_ROOT>\\tools\\pm_tracker.py --session-hook",
        "timeout": 5
      }
    ]
  }
}
